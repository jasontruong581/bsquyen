---
layout: false
pagination:
  data: collections.baiviet
  size: 15
  alias: posts
permalink: "/kien-thuc/{% if pagination.pageNumber > 0 %}trang/{{ pagination.pageNumber + 1 }}/{% endif %}"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kiến thức Ung bướu &amp; Chăm sóc giảm nhẹ{% if pagination.pageNumber > 0 %} — Trang {{ pagination.pageNumber + 1 }}{% endif %} | BS.CKI Hạnh Quyên</title>
  <meta name="description" content="Bài viết kiến thức về ung bướu, tầm soát ung thư và chăm sóc giảm nhẹ — biên soạn và duyệt nội dung bởi BS.CKI Hạnh Quyên, chuyên khoa Ung bướu.">
  <link rel="canonical" href="https://bsquyen.vercel.app{{ page.url }}">
  {%- if pagination.href.previous %}
  <link rel="prev" href="https://bsquyen.vercel.app{{ pagination.href.previous }}">
  {%- endif %}
  {%- if pagination.href.next %}
  <link rel="next" href="https://bsquyen.vercel.app{{ pagination.href.next }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="vi_VN">
  <meta property="og:title" content="Kiến thức Ung bướu &amp; Chăm sóc giảm nhẹ | BS.CKI Hạnh Quyên">
  <meta property="og:description" content="Bài viết kiến thức về ung bướu, tầm soát ung thư và chăm sóc giảm nhẹ — biên soạn bởi bác sĩ chuyên khoa.">
  <meta property="og:url" content="https://bsquyen.vercel.app/kien-thuc/">
  <meta property="og:image" content="https://bsquyen.vercel.app/bsquyen/bsquyen.jpg">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/kien-thuc.css">
</head>
<body>

  {% include "partials/site-header.njk" %}

  <main>
    <section class="section">
      <div class="container article-container">
        <p class="eyebrow">Kiến thức</p>
        <h1>Kiến thức Ung bướu &amp; Chăm sóc giảm nhẹ</h1>
        <p class="article-lead">
          Giải đáp dễ hiểu cho những câu hỏi bệnh nhân và gia đình thường gặp —
          biên soạn và duyệt nội dung bởi BS.CKI Hạnh Quyên.
        </p>

        {# Thanh lọc chủ đề. Chip trên từng card không thể là link vì card vốn đã
           là <a> — lồng <a> trong <a> là HTML không hợp lệ. #}
        <ul class="tag-list tag-nav" aria-label="Lọc theo chủ đề">
          <li><a class="tag tag-active" href="/kien-thuc/" aria-current="page">Tất cả bài</a></li>
          {% for t in chuDe %}
          <li><a class="tag" href="/kien-thuc/chu-de/{{ t | slugify }}/">{{ t }}</a></li>
          {% endfor %}
        </ul>

        <div class="article-list">
          {% for post in posts %}
          {% set dauTien = loop.first %}
          {% include "partials/article-card.njk" %}
          {% endfor %}
        </div>

        {% if pagination.pages.length > 1 %}
        <nav class="pagination" aria-label="Phân trang">
          {% if pagination.href.previous %}
          <a class="page-arrow" href="{{ pagination.href.previous }}">← Mới hơn</a>
          {% endif %}
          {% for href in pagination.hrefs %}
          <a class="page-num{% if page.url == href %} active{% endif %}" href="{{ href }}"{% if page.url == href %} aria-current="page"{% endif %}>{{ loop.index }}</a>
          {% endfor %}
          {% if pagination.href.next %}
          <a class="page-arrow" href="{{ pagination.href.next }}">Cũ hơn →</a>
          {% endif %}
        </nav>
        {% endif %}
      </div>
    </section>
  </main>

  {% include "partials/site-footer.njk" %}

  <script src="/js/kien-thuc.js"></script>
</body>
</html>
